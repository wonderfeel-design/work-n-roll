# Copy to .env and fill in. Never commit .env.

# Person 1: Telegram + Gemma
TELEGRAM_TOKEN=
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Web voice assistant (Task 6); Gemma is its fallback. Gemma thinks 12-18 s per answer, too slow for voice
ASSISTANT_MODEL=gemini-3.5-flash
# optional, for review notifications
AGRONOMIST_CHAT_ID=

# Person 2: ElevenLabs + web
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_STT_MODEL=scribe_v2
WEB_PORT=8000
WEB_USER=admin
WEB_PASSWORD=admin

# Shared
# PostgreSQL (Docker service 'postgres'). Generate a long random password, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Person 1 / other laptops: use the Docker host's Wi-Fi IP instead of localhost.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://fieldvoice:change-me@localhost:5432/fieldvoice
TZ_NAME=Europe/Madrid
